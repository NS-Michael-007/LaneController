<Project Sdk="Microsoft.NET.Sdk">
	<PropertyGroup>
		<TargetFramework>net35</TargetFramework>
		<Deterministic>false</Deterministic>
		<AssemblyTitle>LaneController</AssemblyTitle>

		<!-- 修复版本号报错：阻止 SDK 自动追加 Git 提交哈希 -->
		<AssemblyVersion>1.0.0.0</AssemblyVersion>
		<FileVersion>1.0.0.0</FileVersion>
		<Version>1.0.0</Version>
		<ProductVersion>1.0.0.0</ProductVersion>
		<InformationalVersion>1.0.0</InformationalVersion>
		<IncludeSourceRevisionInInformationalVersion>false</IncludeSourceRevisionInInformationalVersion>
		<GenerateAssemblyFileVersionAttribute>false</GenerateAssemblyFileVersionAttribute>
		<GenerateAssemblyInfo>True</GenerateAssemblyInfo>

		<LangVersion>preview</LangVersion>
		<AssemblyName>LaneController</AssemblyName>
		<RootNamespace>LaneController</RootNamespace>

		<!-- 核心：关闭默认隐式包含，完全手动控制 -->
		<EnableDefaultEmbeddedResourceItems>false</EnableDefaultEmbeddedResourceItems>
		<EnableDefaultCompileItems>true</EnableDefaultCompileItems>
	</PropertyGroup>

	<PropertyGroup Condition="'$(Configuration)|$(Platform)'=='Release|AnyCPU'">
		<DebugType>none</DebugType>
		<DebugSymbols>false</DebugSymbols>
	</PropertyGroup>

	<PropertyGroup Condition="'$(Configuration)|$(Platform)'=='Debug|AnyCPU'">
		<DebugType>portable</DebugType>
		<DebugSymbols>true</DebugSymbols>
	</PropertyGroup>

	<!-- 强制排除所有自动生成的 Designer 文件，彻底阻断二义性 -->
	<ItemGroup>
		<Compile Remove="**\*.Designer.cs" />
	</ItemGroup>

	<!-- 1. 部署逻辑：精准复制，PDB 不存在时跳过 -->
	<Target Name="DeployToModDirectory" AfterTargets="Build">
		<PropertyGroup>
			<ModDirectory>$(LOCALAPPDATA)\Colossal Order\Cities_Skylines\Addons\Mods\$(ProjectName)\</ModDirectory>
		</PropertyGroup>
		<ItemGroup>
			<ModFiles Include="$(TargetDir)$(AssemblyName).dll" />
			<!-- Release 下不生成 PDB，加 Exists 条件避免 Copy 任务报错 -->
			<ModFiles Include="$(TargetDir)$(AssemblyName).pdb" Condition="Exists('$(TargetDir)$(AssemblyName).pdb')" />
			<ModFiles Include="$(ProjectDir)Resources\uui_lane_controller.png" />
		</ItemGroup>
		<Copy SourceFiles="@(ModFiles)" DestinationFolder="$(ModDirectory)" OverwriteReadOnlyFiles="true" />
		<Copy SourceFiles="$(TargetDir)zh-CN\$(AssemblyName).resources.dll" DestinationFolder="$(ModDirectory)zh-CN\" OverwriteReadOnlyFiles="true" Condition="Exists('$(TargetDir)zh-CN\$(AssemblyName).resources.dll')" />
	</Target>

	<ItemGroup>
		<Compile Remove="libs\**" />
		<EmbeddedResource Remove="libs\**" />
		<None Remove="libs\**" />
	</ItemGroup>

	<!-- 2. 双语打包 -->
	<ItemGroup>
<EmbeddedResource Include="ModsCommon\CommonLocalize.resx" />
		<EmbeddedResource Include="ModsCommon\CommonLocalize.zh-cn.resx" />
	</ItemGroup>

